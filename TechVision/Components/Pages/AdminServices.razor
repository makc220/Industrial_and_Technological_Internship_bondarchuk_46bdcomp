@page "/admin/services"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TechVision.Models
@using TechVision.Data
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Керування послугами — TechVision</PageTitle>

<h1>Керування послугами</h1>
<p>Додавання, редагування та видалення послуг компанії.</p>

<div class="card p-3 mb-4">
    <h3>@(editingService == null ? "Додати послугу" : "Редагувати послугу")</h3>

    <EditForm Model="formModel"
          OnValidSubmit="SaveService"
          FormName="ServiceForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Назва послуги</label>
            <InputText class="form-control" @bind-Value="formModel.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Опис</label>
            <InputTextArea class="form-control"
                           @bind-Value="formModel.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Іконка</label>

            <InputText class="form-control"
                    @bind-Value="formModel.Icon" />

            <small class="text-muted">
                Введіть назву Bootstrap Icon без префікса bi.
                Наприклад: bi-code-slash, bi-palette, bi-shield-lock.
            </small>

            @if (!string.IsNullOrWhiteSpace(formModel.Icon))
            {
                <div class="mt-3 d-flex align-items-center gap-2">
                    <span class="text-muted">Попередній перегляд:</span>
                    <i class="@($"bi {formModel.Icon}") fs-2 text-primary"></i>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">
            @(editingService == null ? "Додати" : "Зберегти зміни")
        </button>

        @if (editingService != null)
        {
            <button type="button"
                    class="btn btn-secondary ms-2"
                    @onclick="CancelEdit">
                Скасувати
            </button>
        }
    </EditForm>
</div>

<h3>Список послуг</h3>

@if (services == null)
{
    <p>Завантаження...</p>
}
else if (services.Count == 0)
{
    <p>Послуг поки немає.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Назва</th>
                    <th>Опис</th>
                    <th>Іконка</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in services)
                {
                    <tr>
                        <td>@service.Title</td>
                        <td>@service.Description</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(service.Icon))
                            {
                                <i class="@($"bi {service.Icon}") fs-4 text-primary me-2"></i>
                                <span>@service.Icon</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1"
                                    @onclick="() => EditService(service)">
                                Редагувати
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => DeleteService(service.Id)">
                                Видалити
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@code {
    private List<Service>? services;
    private Service formModel = new();
    private Service? editingService;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadServices();
    }

    private async Task LoadServices()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        services = await db.Services
            .OrderBy(s => s.Title)
            .ToListAsync();
    }

    private async Task SaveService()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (editingService == null)
        {
            db.Services.Add(new Service
            {
                Title = formModel.Title,
                Description = formModel.Description,
                Icon = formModel.Icon
            });

            message = "Послугу успішно додано.";
        }
        else
        {
            var service = await db.Services.FindAsync(editingService.Id);

            if (service == null)
                return;

            service.Title = formModel.Title;
            service.Description = formModel.Description;
            service.Icon = formModel.Icon;

            message = "Послугу успішно оновлено.";
        }

        await db.SaveChangesAsync();

        formModel = new Service();
        editingService = null;

        await LoadServices();
    }

    private void EditService(Service service)
    {
        editingService = service;

        formModel = new Service
        {
            Title = service.Title,
            Description = service.Description,
            Icon = service.Icon
        };

        message = null;
    }

    private async Task DeleteService(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var service = await db.Services.FindAsync(id);

        if (service == null)
            return;

        db.Services.Remove(service);
        await db.SaveChangesAsync();

        if (editingService?.Id == id)
            CancelEdit();

        message = "Послугу видалено.";

        await LoadServices();
    }

    private void CancelEdit()
    {
        editingService = null;
        formModel = new Service();
        message = null;
    }
}
