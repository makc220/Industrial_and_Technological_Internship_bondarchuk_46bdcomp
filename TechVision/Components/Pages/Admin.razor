@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using TechVision.Data
@using TechVision.Models

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Панель адміністратора — TechVision</PageTitle>

<div class="admin-dashboard">

    <div class="admin-header">
        <div>
            <span class="admin-label">TECHVISION ADMINISTRATION</span>
            <h1>Панель адміністратора</h1>
            <p>
                Вітаємо в адміністративній панелі TechVision!
                Тут ви можете керувати вмістом вебсайту.
            </p>
        </div>

        <label class="admin-header-icon"
            for="avatarUpload"
            title="Натисніть, щоб змінити зображення">

            @if (!string.IsNullOrEmpty(avatarDataUrl))
            {
                <img src="@avatarDataUrl" alt="Аватар адміністратора" />
            }
            else
            {
                <i class="bi bi-person-gear"></i>
            }

            <span class="avatar-edit-hint">
                <i class="bi bi-camera-fill"></i>
            </span>
        </label>

        <InputFile id="avatarUpload"
                OnChange="UploadAvatar"
                accept="image/png,image/jpeg,image/webp"
                class="visually-hidden" />
            </div>

    <div class="admin-section-heading">
        <h2>Керування сайтом</h2>
        <p>Оберіть розділ, з яким бажаєте працювати.</p>
    </div>

    <div class="row g-4">

        <div class="col-12 col-md-6 col-xl-4">
            <div class="admin-card h-100">
                <div class="admin-card-icon services-icon">
                    <i class="bi bi-grid-1x2"></i>
                </div>

                <h3>Послуги</h3>

                <p>
                    Додавайте, редагуйте та видаляйте
                    послуги, які пропонує компанія.
                </p>

                <a href="/admin/services" class="admin-card-link">
                    Керувати послугами
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="admin-card h-100">
                <div class="admin-card-icon news-icon">
                    <i class="bi bi-newspaper"></i>
                </div>

                <h3>Новини</h3>

                <p>
                    Публікуйте новини компанії,
                    змінюйте їхній вміст або видаляйте за потреби.
                </p>

                <a href="/admin/news" class="admin-card-link">
                    Керувати новинами
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="admin-card h-100">
                <div class="admin-card-icon messages-icon">
                    <i class="bi bi-envelope"></i>
                </div>

                <h3>Повідомлення</h3>

                <p>
                    Переглядайте звернення відвідувачів,
                    отримані через контактну форму сайту.
                </p>

                <a href="/admin/messages" class="admin-card-link">
                    Переглянути повідомлення
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>

        @if (!string.IsNullOrWhiteSpace(avatarMessage))
        {
            <div class="alert @avatarMessageClass mt-3" role="status">
                @avatarMessage
            </div>
        }

    <div class="admin-footer">
        <div>
            <i class="bi bi-shield-check"></i>
            <span>Ви авторизовані як адміністратор</span>
        </div>

        <form method="post" action="/admin/logout">
            <AntiforgeryToken />
            <button type="submit" class="admin-logout">
                <i class="bi bi-box-arrow-right"></i>
                Вийти з облікового запису
            </button>
        </form>
    </div>

</div>

<style>
