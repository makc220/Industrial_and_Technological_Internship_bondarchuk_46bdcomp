</style>


@code {
    private const long MaxAvatarSize = 2 * 1024 * 1024;

    private string? avatarDataUrl;
    private string? avatarMessage;
    private string avatarMessageClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadAvatar();
    }

    private async Task LoadAvatar()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (string.IsNullOrWhiteSpace(username))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var admin = await db.AdminUsers
            .FirstOrDefaultAsync(a => a.Username == username);

        if (admin?.AvatarImage != null &&
            !string.IsNullOrWhiteSpace(admin.AvatarContentType))
        {
            avatarDataUrl =
                $"data:{admin.AvatarContentType};base64,{Convert.ToBase64String(admin.AvatarImage)}";
        }
    }

    private async Task UploadAvatar(InputFileChangeEventArgs e)
    {
        avatarMessage = null;

        var file = e.File;

        var allowedTypes = new[]
        {
            "image/png",
            "image/jpeg",
            "image/webp"
        };

        if (!allowedTypes.Contains(file.ContentType))
        {
            ShowAvatarMessage(
                "Дозволені лише зображення PNG, JPG, JPEG та WEBP.",
                "alert-danger");
            return;
        }

        if (file.Size == 0 || file.Size > MaxAvatarSize)
        {
            ShowAvatarMessage(
                "Розмір зображення не повинен перевищувати 2 МБ.",
                "alert-danger");
            return;
        }

        byte[] imageBytes;

        try
        {
            await using var stream = file.OpenReadStream(MaxAvatarSize);
            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);
            imageBytes = memoryStream.ToArray();
        }
        catch (IOException)
        {
            ShowAvatarMessage(
                "Не вдалося прочитати файл. Спробуйте інше зображення.",
                "alert-danger");
            return;
        }

        if (!IsValidImage(imageBytes, file.ContentType))
        {
            ShowAvatarMessage(
                "Файл не є коректним зображенням зазначеного формату.",
                "alert-danger");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;

        if (string.IsNullOrWhiteSpace(username))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var admin = await db.AdminUsers
            .FirstOrDefaultAsync(a => a.Username == username);

        if (admin == null)
        {
            ShowAvatarMessage(
                "Обліковий запис адміністратора не знайдено.",
                "alert-danger");
            return;
        }

        admin.AvatarImage = imageBytes;
        admin.AvatarContentType = file.ContentType;

        await db.SaveChangesAsync();

        avatarDataUrl =
            $"data:{file.ContentType};base64,{Convert.ToBase64String(imageBytes)}";

        ShowAvatarMessage(
            "Зображення адміністратора успішно збережено.",
            "alert-success");
    }

    private static bool IsValidImage(byte[] bytes, string contentType)
    {
        if (contentType == "image/png")
        {
            byte[] signature =
            {
                0x89, 0x50, 0x4E, 0x47,
                0x0D, 0x0A, 0x1A, 0x0A
            };

            return bytes.Length >= signature.Length &&
                   bytes.AsSpan(0, signature.Length)
                       .SequenceEqual(signature);
        }

        if (contentType == "image/jpeg")
        {
            return bytes.Length >= 3 &&
                   bytes[0] == 0xFF &&
                   bytes[1] == 0xD8 &&
                   bytes[2] == 0xFF;
        }

        if (contentType == "image/webp")
        {
            return bytes.Length >= 12 &&
                   System.Text.Encoding.ASCII.GetString(bytes, 0, 4) == "RIFF" &&
                   System.Text.Encoding.ASCII.GetString(bytes, 8, 4) == "WEBP";
        }

        return false;
    }

    private void ShowAvatarMessage(string text, string cssClass)
    {
        avatarMessage = text;
        avatarMessageClass = cssClass;
    }
}
