@page "/admin/messages"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TechVision.Data
@using TechVision.Models
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Повідомлення — TechVision</PageTitle>

<h1>Повідомлення</h1>
<p>Перегляд повідомлень, надісланих відвідувачами сайту.</p>

@if (messages == null)
{
    <p>Завантаження повідомлень...</p>
}
else if (messages.Count == 0)
{
    <div class="alert alert-info">
        Повідомлень поки немає.
    </div>
}
else
{
    <div class="mb-3">
        <span class="badge bg-primary">
            Усього повідомлень: @messages.Count
        </span>
    </div>

    <div class="row g-3">
        @foreach (var item in messages)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-3 p-md-4">

                        <div class="d-flex flex-column flex-md-row
                                    justify-content-between gap-3">

                            <div class="flex-grow-1">
                                <h5 class="card-title mb-2">
                                    @item.Name
                                </h5>

                                <p class="mb-1">
                                    <i class="bi bi-envelope text-primary me-2"></i>
                                    <a href="mailto:@item.Email">
                                        @item.Email
                                    </a>
                                </p>

                                <p class="text-muted small mb-3">
                                    <i class="bi bi-calendar me-2"></i>
                                    @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                </p>

                                <div class="p-3 rounded"
                                     style="background: #f1f5f9; white-space: pre-wrap; overflow-wrap: anywhere;">
                                    @item.Message
                                </div>
                            </div>

                            <div class="flex-shrink-0">
                                @if (confirmationId == item.Id)
                                {
                                    <div class="d-flex flex-column gap-2">
                                        <span class="text-danger small">
                                            Видалити повідомлення?
                                        </span>

                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => DeleteMessage(item.Id)">
                                            Підтвердити
                                        </button>

                                        <button class="btn btn-secondary btn-sm"
                                                @onclick="CancelDelete">
                                            Скасувати
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => AskDelete(item.Id)">
                                        <i class="bi bi-trash me-1"></i>
                                        Видалити
                                    </button>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info mt-3">
        @message
    </div>
}

@code {
    private List<ContactMessage>? messages;
    private int? confirmationId;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadMessages();
    }

    private async Task LoadMessages()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        messages = await db.ContactMessages
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();
    }

    private void AskDelete(int id)
    {
        confirmationId = id;
        message = null;
    }

    private void CancelDelete()
    {
        confirmationId = null;
    }

    private async Task DeleteMessage(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var item = await db.ContactMessages.FindAsync(id);

        if (item == null)
            return;

        db.ContactMessages.Remove(item);
        await db.SaveChangesAsync();

        confirmationId = null;
        message = "Повідомлення успішно видалено.";

        await LoadMessages();
    }
}
