@page "/news"
@using Microsoft.EntityFrameworkCore
@using TechVision.Data
@using TechVision.Models
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Новини — TechVision</PageTitle>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Новини компанії</h1>
        <p class="lead text-muted">
            Останні події та оновлення TechVision.
        </p>
    </div>

    @if (news == null)
    {
        <p class="text-center">Завантаження новин...</p>
    }
    else if (news.Count == 0)
    {
        <p class="text-center">Поки що новин немає.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in news)
            {
                <div class="col-md-6">
                    <article class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-2 text-primary small mb-2">
                                @if (!string.IsNullOrWhiteSpace(item.Icon))
                                {
                                    <i class="@($"bi {item.Icon}") fs-5"></i>
                                }

                                <span>@item.PublishedAt.ToString("dd.MM.yyyy")</span>
                            </div>

                            <h2 class="h4">@item.Title</h2>

                            <p class="text-muted mb-0"
                               style="white-space: pre-line">
                                @item.Content
                            </p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<News>? news;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        news = await db.News
            .OrderByDescending(n => n.PublishedAt)
            .ToListAsync();
    }
}
