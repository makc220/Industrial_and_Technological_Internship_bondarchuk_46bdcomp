@page "/"

<PageTitle>Головна — TechVision</PageTitle>

<div class="container py-5">

    <!-- Головний блок -->
    <section class="text-center py-5 px-3 mb-5 rounded-4"
             style="background: #102747; color: white;">

        <span class="badge bg-primary mb-3">
            IT-рішення для бізнесу
        </span>

        <h1 class="display-4 fw-bold mb-3">
            Технології, що відкривають нові можливості
        </h1>

        <p class="lead mx-auto mb-4"
           style="max-width: 700px; color: #d5e1ef;">
            Створюємо сучасні цифрові рішення для розвитку,
            автоматизації та ефективності вашого бізнесу.
        </p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
            <a href="/services" class="btn btn-primary btn-lg">
                Наші послуги
            </a>

            <a href="/news" class="btn btn-outline-light btn-lg">
                Наші новини
            </a>
        </div>
    </section>

    <!-- Про компанію -->
    <section class="mb-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Про компанію</h2>
            <p class="text-muted">
                Ваш партнер у світі сучасних технологій
            </p>
        </div>

        <p class="text-center mx-auto"
           style="max-width: 800px;">
            TechVision —  IT-компанія, що спеціалізується
            на створенні програмного забезпечення, вебсайтів
            та цифрових рішень для сучасного бізнесу.
            Наша мета — допомагати компаніям використовувати
            можливості інформаційних технологій.
        </p>
    </section>

    <!-- Напрями діяльності -->
    <section class="mb-5">
        <h2 class="fw-bold text-center mb-4">
            Наші напрями діяльності
        </h2>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-code-slash fs-1 text-primary"></i>
                        <h3 class="h5 mt-3">Розробка ПЗ</h3>
                        <p class="text-muted mb-0">
                            Створення програмного забезпечення
                            відповідно до потреб бізнесу.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-window fs-1 text-primary"></i>
                        <h3 class="h5 mt-3">Веброзробка</h3>
                        <p class="text-muted mb-0">
                            Розробка сучасних вебсайтів
                            та вебзастосунків.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-lightbulb fs-1 text-primary"></i>
                        <h3 class="h5 mt-3">Цифрові рішення</h3>
                        <p class="text-muted mb-0">
                            Використання технологій для
                            оптимізації бізнес-процесів.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Перехід до послуг -->
    <section class="text-center rounded-4 p-5"
             style="background: #edf3fa;">

        <h2 class="fw-bold mb-3">
            Готові до нових можливостей?
        </h2>

        <p class="text-muted mb-4">
            Ознайомтеся з послугами TechVision
            та знайдіть рішення для свого бізнесу.
        </p>

        <a href="/services" class="btn btn-primary btn-lg">
            Переглянути послуги
        </a>

    </section>

</div>
