@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">TechVision</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill me-2"></i>
                Головна
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/services">
                <i class="bi bi-grid-1x2"></i>
                Послуги
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/news">
                <i class="bi bi-newspaper me-2"></i>
                Новини
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/contacts">
                <i class="bi bi-envelope-fill me-2"></i>
                Контакти
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-4 mb-2">
            <div class="text-uppercase small text-white-50 fw-bold px-3">
                Обліковий запис
            </div>
        </div>

        <AuthorizeView Roles="Admin">
            <Authorized Context="authState">

                <div class="nav-item px-3">
                    <div class="nav-link text-white-50 small">
                        <i class="bi bi-person-check me-2"></i>
                        @authState.User.Identity?.Name
                    </div>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin">
                        <i class="bi bi-speedometer2 me-2"></i>
                        Панель адміністратора
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <form method="post" action="/admin/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Вийти
                        </button>
                    </form>
                </div>

            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/login">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Увійти
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>
